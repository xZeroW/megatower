// Event rooms: a scene and choices; each choice rolls one weighted result.
// Effects: Heal(% life), Hurt(% life, never kills), Gold(n + 5/floor), Gem,
// Item (magic or better), Boon, Xp(n per floor). Shape: `EventDef` in
// crates/megatower-sim/src/rooms.rs.
[
    (
        id: "fountain",
        name: "Murky Fountain",
        text: "Dark water bubbles up from a cracked basin. It smells of iron.",
        choices: [
            (label: "Drink", results: [
                (weight: 60, text: "The water is sweet. Your wounds close.", effects: [Heal(50.0)]),
                (weight: 40, text: "It burns going down.", effects: [Hurt(20.0)]),
            ]),
            (label: "Walk away", results: [
                (weight: 1, text: "You leave the fountain be.", effects: []),
            ]),
        ],
    ),
    (
        id: "fallen_adventurer",
        name: "Fallen Adventurer",
        text: "A body slumps against the wall, pack still strapped on. Something skitters nearby.",
        choices: [
            (label: "Search the pack", results: [
                (weight: 65, text: "You find something useful.", effects: [Item]),
                (weight: 35, text: "Rats burst from the pack and bite before fleeing.", effects: [Hurt(15.0), Gold(10)]),
            ]),
            (label: "Take only the coin purse", results: [
                (weight: 1, text: "A handful of coins.", effects: [Gold(15)]),
            ]),
        ],
    ),
    (
        id: "ancient_idol",
        name: "Ancient Idol",
        text: "A stone idol with ruby eyes watches the room. Old offerings rot at its feet.",
        choices: [
            (label: "Pray", results: [
                (weight: 1, text: "Power floods you, and it takes its price.", effects: [Boon, Hurt(25.0)]),
            ]),
            (label: "Pry out the eyes", results: [
                (weight: 1, text: "The rubies come loose.", effects: [Gold(40)]),
            ]),
            (label: "Leave", results: [
                (weight: 1, text: "You step around it.", effects: []),
            ]),
        ],
    ),
    (
        id: "gem_cutter",
        name: "Gem Cutter's Bench",
        text: "A workbench with fine tools and a journal of cutting notes.",
        choices: [
            (label: "Search the drawers", results: [
                (weight: 1, text: "A gem was left behind.", effects: [Gem]),
            ]),
            (label: "Study the journal", results: [
                (weight: 1, text: "You learn a few tricks.", effects: [Xp(12)]),
            ]),
        ],
    ),
    (
        id: "alchemist_table",
        name: "Abandoned Alchemy Table",
        text: "Flasks of strange liquid still glow faintly on a cracked table.",
        choices: [
            (label: "Mix a draught", results: [
                (weight: 55, text: "The mixture crystallises into a small orb.", effects: [Orb]),
                (weight: 45, text: "It fizzes and burns your hands.", effects: [Hurt(12.0)]),
            ]),
            (label: "Drink a vial", results: [
                (weight: 1, text: "Bitter, but restoring.", effects: [Heal(30.0)]),
            ]),
        ],
    ),
    (
        id: "cursed_chest",
        name: "Chained Chest",
        text: "A chest wrapped in rusting chains. Something whispers from within.",
        choices: [
            (label: "Break the chains", results: [
                (weight: 50, text: "The lid bursts open.", effects: [Item, Orb]),
                (weight: 50, text: "A curse lashes out as the chains fall.", effects: [Hurt(30.0), Gold(20)]),
            ]),
            (label: "Pick the lock", results: [
                (weight: 1, text: "Patience pays.", effects: [Gold(30)]),
            ]),
            (label: "Leave it", results: [
                (weight: 1, text: "You leave it chained.", effects: []),
            ]),
        ],
    ),
    (
        id: "wandering_trader",
        name: "Wandering Peddler",
        text: "A hooded peddler sits among crates, humming, and spreads their wares.",
        choices: [
            (label: "Buy a curiosity", cost: 35, results: [
                (weight: 1, text: "Wrapped in cloth, a small orb.", effects: [Orb]),
            ]),
            (label: "Buy a gem", cost: 50, results: [
                (weight: 1, text: "A gem that glints from within a pouch.", effects: [Gem]),
            ]),
            (label: "Chat", results: [
                (weight: 1, text: "The peddler shares a few tips.", effects: [Xp(8)]),
            ]),
        ],
    ),
    (
        id: "bone_shrine",
        name: "Shrine of Bones",
        text: "Skulls ring a pool of black water. A voice offers a trade.",
        choices: [
            (label: "Offer blood", results: [
                (weight: 1, text: "The pool drinks, and shows you the way.", effects: [Hurt(20.0), Xp(25)]),
            ]),
            (label: "Offer coin", cost: 25, results: [
                (weight: 1, text: "The skulls clatter in approval.", effects: [Heal(60.0)]),
            ]),
            (label: "Leave", results: [
                (weight: 1, text: "You back away from the pool.", effects: []),
            ]),
        ],
    ),
    (
        id: "collapsed_library",
        name: "Collapsed Library",
        text: "Shelves lie toppled over scattered tomes. One book is unharmed.",
        choices: [
            (label: "Read the book", results: [
                (weight: 70, text: "Dense, but you take something away.", effects: [Xp(15)]),
                (weight: 30, text: "A gem was pressed between the pages.", effects: [Gem, Xp(5)]),
            ]),
            (label: "Search the rubble", results: [
                (weight: 60, text: "Coins, dust and a few scratches.", effects: [Gold(18), Hurt(8.0)]),
                (weight: 40, text: "A tarnished piece of gear.", effects: [Item]),
            ]),
        ],
    ),
]
